
# Cudy TR3600 v1 only - appended after devices/common/.config, so these win.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# Only build the one device.  devices/common/.config sets
# CONFIG_TARGET_ALL_PROFILES=y, which would build every filogic board.
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_MULTI_PROFILE=y
# MUST stay n.  PER_DEVICE_ROOTFS makes the OpenWrt image machinery expand
# every recipe for every device in the target, including the ones we did NOT
# select.  target/linux/mediatek/image/filogic.mk:13 then calls
#   gen_netgear_rootfs_node.sh .../root.squashfs$(if $(TARGET_PER_DEVICE_ROOTFS),+pkg=$(ROOTFS_ID/$(DEVICE_NAME)))
# and ROOTFS_ID is only defined for a device when its profile is selected
# (include/image.mk:608-611), so for netgear_eax17 the path becomes the
# non-existent "root.squashfs+pkg=" -> empty .its node -> mkimage aborts with
# "FATAL ERROR: Unable to parse input tree" -> target/linux failed to build.
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_tr3600-v1=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_re3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_wr3000-v1=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_yuncore_ax835=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_gatonetworks_gdsp=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netgear_wax220=n

# --- USB cellular tethering ------------------------------------------------
# Kwrt (openwrt.ai) builds these images without the usbnet family, so a USB
# 4G/LTE dongle enumerates but can never get a driver - "plugged in, no
# internet".  These are all plain kernel modules from the base kernel-module
# set (no telephony feed needed, which Kwrt removes).
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# --- USB wired-Ethernet dongle as LAN (software repair for a dead RJ45) -----
# If the on-board LAN PHY (eth1) is physically damaged, a USB 3.0 GbE
# dongle (Realtek RTL8153 -> r8152, or ASIX AX88179 -> asix) plugged into
# the TR3600's USB port becomes a working LAN port via hotplug.d/net/30-*.
# NOTE: these are wired adapters only - the 4G tether (cdc_ether) is handled
# separately by 25-tr3600-usb-tether and must NOT be bridged here.
CONFIG_PACKAGE_kmod-usb-net-r8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y

# --- Hardware NAT / PPE offload (mtk_hnat) ---------------------------------
# MediaTek filogic (MT7987) MAC has a hardware packet-processing engine (PPE).
# This offloads the *established* IPv4 NAT fast-path to hardware: first packet
# still goes through software to build the conntrack/foe entry, subsequent
# packets of the same flow are rewritten + forwarded by PPE with ~no CPU. It is
# the single biggest WAN->LAN throughput lever on a 2.5G port (a 3x A53 alone
# cannot NAT-gigabit+ at line rate).
#
# Caveats (why NOT always-on): flows that need per-packet software fall back to
# the slow path / disable offload - VPN-tunneled traffic (opaque), SQM/HTB/cake
# shaping, deep firewall/nft marks, ICMP/fragmented/ESP. If you rely on QoS or
# full-tunnel VPN the benefit shrinks; disable then (set 'enabled 0' in
# /etc/config/mtkhnat or drop the mtk_hnat module).
#
# kmod-mediatek_hnat pulls CONFIG_NET_MEDIATEK_HNAT=y and depends on
# kmod-mediatek_eth (already present). 'mtkhnat' adds the /etc/config/mtkhnat
# toggle so it can be switched off at runtime without a reflash. If those
# package symbols do not exist in a given base feed they are simply no-ops.
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_mtkhnat=y

# --- Optional feature set (ported from stock Cudy; all standard OpenWrt pkgs) -
# NOTHING cloud-related (cmagent/cmsd/cwmp/l2portal/mesh/bdinfo) is ever added.
#
# Remote access / SD-WAN. 4G uplinks are usually CGNAT (no public IP), so remote
# access has to ride a relay/SD-WAN - WireGuard (fast, in-kernel), OpenVPN,
# ZeroTier. EasyTier is user-supplied (see files/usr/sbin/tr3600-easytier-helper).
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
#
# USB 3.0 -> NAS: plug a USB drive = SMB share / DLNA on the LAN.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y
#
# Privacy / convenience: encrypted DNS (DoT stubby), DDNS, UPnP/NAT-PMP
# (convenience vs. security tradeoff), mDNS (umdns, built-in), usb-modeswitch
# for other modem dongles.
CONFIG_PACKAGE_stubby=y
CONFIG_PACKAGE_luci-app-stubby=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_umdns=y
CONFIG_PACKAGE_usb-modeswitch=y
#
# Maintenance: scheduled reboot (cron). NOTE: SQM/QoS (nft-qos/sqm-scripts) is
# deliberately NOT enabled - traffic shaping forces flows back to the software
# path and would defeat the mtk_hnat offload we just added. Add SQM ONLY if you
# decide shaping matters more than raw throughput (and expect to disable HNAT).
CONFIG_PACKAGE_luci-app-autoreboot=y

# --- LuCI theme ------------------------------------------------------------
# Neither devices/common/.config nor our overlay selected a LuCI theme, so the
# image fell back to bare bootstrap while luci.main.mediaurlbase still pointed
# at /luci-static/aurora (luci-base ships aurora's ucode templates but NOT its
# static assets).  Result: login page requests
#   /luci-static/aurora/login.css, images/logo.svg, fonts/lato-*.woff2
# which all 404 -> unstyled LuCI.
# luci-theme-aurora is the standard LuCI feed theme and provides exactly those
# files.  (# CONFIG_PACKAGE_luci-theme-vantage is the other option: it is the
# one kwrt/openwrt.ai ships by default - 99-default-settings sets mediaurlbase
# to /luci-static/vantage when /usr/share/ucode/luci/template/themes/vantage
# exists - but it lives in the kiddin9 feed and pulls luci-app-vantage.)
CONFIG_PACKAGE_luci-theme-aurora=y

# kwrt/openwrt.ai's own default theme.  Kwrt's 99-default-settings:76 does
#   [ -d /usr/share/ucode/luci/template/themes/vantage ] && \
#     uci -q set luci.main.mediaurlbase='/luci-static/vantage'
# so picking it up here makes it the default automatically (aurora stays
# installed, so the theme can still be switched in LuCI > System > System).
# It ships in the kiddin9 feed that diy.sh adds, and its only extra
# dependency is luci-app-vantage (the live dashboard, admin/dashboard).
# All of its other deps (rpcd, rpcd-mod-iwinfo/ucode, ucode-mod-uci/ubus)
# are core packages already built into every image.
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
